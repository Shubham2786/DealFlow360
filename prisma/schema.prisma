// DealFlow360 Prisma schema.
// Models are added incrementally per module (see tasks.md). This file currently
// contains the datasource, generator, and shared domain enums. Auth/domain models
// are introduced in their respective module commits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- System settings (key/value). First concrete model; used by Admin module. ----
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---- Auth / Users ----
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         UserRole       @default(SALESPERSON)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  quotations    Quotation[]
  approvalSteps ApprovalStep[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---- Customers ----
model Customer {
  id           String       @id @default(cuid())
  name         String
  segment      CustomerSegment @default(STANDARD)
  contactName  String?
  contactEmail String?
  contactPhone String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  quotations   Quotation[]
  invoices     Invoice[]

  @@map("customers")
}

// ---- Products ----
model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  category       String?
  type           ProductType     @default(ONE_TIME)
  basePrice      Decimal         @db.Decimal(12, 2)
  currency       String          @default("USD")
  uom            String          @default("unit")
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quotationLines QuotationLine[]

  @@map("products")
}

// ---- Quotations (Deal core) ----
model Quotation {
  id            String          @id @default(cuid())
  number        String          @unique
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  salespersonId String?
  salesperson   User?           @relation(fields: [salespersonId], references: [id])
  status        QuotationStatus @default(DRAFT)
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discountPct   Decimal         @default(0) @db.Decimal(5, 2)
  discountTotal Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  marginPct     Decimal         @default(0) @db.Decimal(5, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime?
  lines         QuotationLine[]
  invoices      Invoice[]
  approvalRequests ApprovalRequest[]

  @@index([status])
  @@index([customerId])
  @@map("quotations")
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  qty         Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal   @default(0) @db.Decimal(14, 2)

  @@index([quotationId])
  @@map("quotation_lines")
}

// ---- Approvals ----
model ApprovalRequest {
  id          String                @id @default(cuid())
  quotationId String
  quotation   Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status      ApprovalRequestStatus  @default(PENDING)
  reason      String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  steps       ApprovalStep[]

  @@index([quotationId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalStep {
  id         String             @id @default(cuid())
  requestId  String
  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level      Int
  role       UserRole
  status     ApprovalStepStatus @default(PENDING)
  approverId String?
  approver   User?              @relation(fields: [approverId], references: [id])
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  @@index([requestId])
  @@map("approval_steps")
}

// ---- Invoices ----
model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  quotationId String?
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime?
  dueDate     DateTime?
  total       Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([dueDate])
  @@map("invoices")
}

// ---- Audit ----
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  entityType String
  entityId   String?
  action     String
  message    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---- Shared domain enums (mirror packages/shared/src/enums.ts) ----

enum UserRole {
  SALESPERSON
  SALES_MANAGER
  FINANCE
  OPERATIONS
  ADMIN
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  NEGOTIATION
  CONVERTED_TO_FULFILLMENT
  FULFILLING
  PARTIALLY_FULFILLED
  FULFILLED
  BILLING
  INVOICED
  PAID
  COMPLETED
  CANCELLED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  ESCALATED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum FulfillmentStatus {
  PENDING
  ALLOCATING
  ALLOCATED
  PARTIALLY_ALLOCATED
  BACKORDERED
  READY_TO_SHIP
  FULFILLED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  CANCELLED
}

enum BackorderStatus {
  OPEN
  PARTIALLY_ALLOCATED
  FULFILLED
  CANCELLED
}

enum AllocationSource {
  INITIAL
  BACKORDER
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ProductType {
  ONE_TIME
  RECURRING
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum CustomerSegment {
  STANDARD
  SMB
  ENTERPRISE
  STRATEGIC
}
