// DealFlow360 Prisma schema.
// Models are added incrementally per module (see tasks.md). This file currently
// contains the datasource, generator, and shared domain enums. Auth/domain models
// are introduced in their respective module commits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- System settings (key/value). First concrete model; used by Admin module. ----
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---- Auth / Users / RBAC ----
model Role {
  id          String           @id @default(cuid())
  name        String           @unique // USER | MANAGER | FINANCE | ADMIN
  description String?
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  status       String         @default("ACTIVE") // ACTIVE | SUSPENDED
  tokenVersion Int            @default(0) // bumped on role change to invalidate sessions
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  quotations    Quotation[]    @relation("Salesperson")
  createdQuotations Quotation[] @relation("Creator")
  approvalSteps ApprovalStep[]

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---- Customers ----
model Customer {
  id           String       @id @default(cuid())
  name         String
  segment      CustomerSegment @default(STANDARD)
  contactName  String?
  contactEmail String?
  contactPhone String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  quotations   Quotation[]
  invoices     Invoice[]
  fulfillments Fulfillment[]
  subscriptions Subscription[]

  @@map("customers")
}

// ---- Products ----
model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  category       String?
  type           ProductType     @default(ONE_TIME)
  basePrice      Decimal         @db.Decimal(14, 2)
  costPrice      Decimal         @default(0) @db.Decimal(14, 2)
  currency       String          @default("INR")
  uom            String          @default("unit")
  taxRate        Decimal         @default(18) @db.Decimal(5, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quotationLines QuotationLine[]
  inventory        Inventory[]
  fulfillmentLines FulfillmentLine[]
  subscriptionLines SubscriptionLine[]

  @@map("products")
}

// ---- Quotations (Deal core) ----
model Quotation {
  id            String          @id @default(cuid())
  number        String          @unique
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  salespersonId String?
  salesperson   User?           @relation("Salesperson", fields: [salespersonId], references: [id])
  createdById   String?
  createdBy     User?           @relation("Creator", fields: [createdById], references: [id])
  status        QuotationStatus @default(DRAFT)
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discountPct   Decimal         @default(0) @db.Decimal(5, 2)
  discountTotal Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  marginPct     Decimal         @default(0) @db.Decimal(5, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime?
  lines         QuotationLine[]
  invoices      Invoice[]
  approvalRequests ApprovalRequest[]
  fulfillment   Fulfillment?
  negotiation   Negotiation?
  subscriptions Subscription[]

  @@index([status])
  @@index([customerId])
  @@index([createdById])
  @@map("quotations")
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  qty         Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal   @default(0) @db.Decimal(14, 2)

  @@index([quotationId])
  @@map("quotation_lines")
}

// ---- Negotiation / Customer Portal ----
model Negotiation {
  id          String               @id @default(cuid())
  quotationId String               @unique
  quotation   Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status      String               @default("OPEN") // OPEN | CUSTOMER_RESPONDED | ACCEPTED | REJECTED | CLOSED
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  messages    NegotiationMessage[]
  token       PortalToken?

  @@map("negotiations")
}

model NegotiationMessage {
  id                 String      @id @default(cuid())
  negotiationId      String
  negotiation        Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  author             String      // INTERNAL | CUSTOMER
  body               String
  requestedDiscountPct Decimal?  @db.Decimal(5, 2)
  createdAt          DateTime    @default(now())

  @@index([negotiationId])
  @@map("negotiation_messages")
}

model PortalToken {
  id            String      @id @default(cuid())
  negotiationId String      @unique
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  token         String      @unique
  expiresAt     DateTime
  revoked       Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("portal_tokens")
}

// ---- Fulfillment / Inventory / Allocation / Backorders ----
model Warehouse {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  priority    Int           @default(100)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  inventory   Inventory[]
  allocations Allocation[]
  receipts    InventoryReceipt[]

  @@map("warehouses")
}

model Inventory {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  onHand      Int           @default(0)
  reserved    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reservations Reservation[]
  allocations  Allocation[]

  @@unique([productId, warehouseId])
  @@index([productId])
  @@map("inventory")
}

model Fulfillment {
  id          String            @id @default(cuid())
  number      String            @unique
  quotationId String            @unique
  quotation   Quotation         @relation(fields: [quotationId], references: [id])
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  status      FulfillmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       FulfillmentLine[]

  @@index([status])
  @@map("fulfillments")
}

model FulfillmentLine {
  id            String            @id @default(cuid())
  fulfillmentId String
  fulfillment   Fulfillment       @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  orderedQty    Int
  allocatedQty  Int               @default(0)
  fulfilledQty  Int               @default(0)
  backorderedQty Int              @default(0)
  status        FulfillmentStatus @default(PENDING)
  reservations  Reservation[]
  allocations   Allocation[]
  backorders    Backorder[]

  @@index([fulfillmentId])
  @@map("fulfillment_lines")
}

model Reservation {
  id                String            @id @default(cuid())
  inventoryId       String
  inventory         Inventory         @relation(fields: [inventoryId], references: [id])
  fulfillmentLineId String
  fulfillmentLine   FulfillmentLine   @relation(fields: [fulfillmentLineId], references: [id], onDelete: Cascade)
  quantity          Int
  status            ReservationStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  releasedAt        DateTime?
  fulfilledAt       DateTime?
  allocation        Allocation?

  @@index([inventoryId])
  @@index([fulfillmentLineId])
  @@map("reservations")
}

model Allocation {
  id                String           @id @default(cuid())
  fulfillmentLineId String
  fulfillmentLine   FulfillmentLine  @relation(fields: [fulfillmentLineId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])
  inventoryId       String
  inventory         Inventory        @relation(fields: [inventoryId], references: [id])
  reservationId     String?          @unique
  reservation       Reservation?     @relation(fields: [reservationId], references: [id])
  quantity          Int
  source            AllocationSource @default(INITIAL)
  createdAt         DateTime         @default(now())

  @@index([fulfillmentLineId])
  @@map("allocations")
}

model Backorder {
  id                String          @id @default(cuid())
  fulfillmentLineId String
  fulfillmentLine   FulfillmentLine @relation(fields: [fulfillmentLineId], references: [id], onDelete: Cascade)
  productId         String
  originalQty       Int
  remainingQty      Int
  status            BackorderStatus @default(OPEN)
  priority          Int             @default(100)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([productId])
  @@map("backorders")
}

model InventoryReceipt {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  quantity    Int
  reference   String    @unique
  receivedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@map("inventory_receipts")
}

// ---- Approvals ----
model ApprovalRequest {
  id          String                @id @default(cuid())
  quotationId String
  quotation   Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status      ApprovalRequestStatus  @default(PENDING)
  reason      String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  steps       ApprovalStep[]

  @@index([quotationId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalStep {
  id         String             @id @default(cuid())
  requestId  String
  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level      Int
  role       String
  status     ApprovalStepStatus @default(PENDING)
  approverId String?
  approver   User?              @relation(fields: [approverId], references: [id])
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  @@index([requestId])
  @@map("approval_steps")
}

// ---- Invoices / Payments (India: GST, INR) ----
model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  quotationId  String?
  quotation    Quotation?    @relation(fields: [quotationId], references: [id])
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime?
  dueDate      DateTime?
  paymentTerms String        @default("Net 30")
  subtotal     Decimal       @default(0) @db.Decimal(14, 2)
  gstTotal     Decimal       @default(0) @db.Decimal(14, 2)
  total        Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(14, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([status])
  @@index([customerId])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int
  unitPrice   Decimal @db.Decimal(14, 2)
  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  method     String   @default("UPI")
  reference  String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ---- Subscriptions (Recurring contracts) ----
model Subscription {
  id              String             @id @default(cuid())
  number          String             @unique
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  quotationId     String?
  quotation       Quotation?         @relation(fields: [quotationId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  frequency       BillingFrequency   @default(ANNUAL)
  startDate       DateTime           @default(now())
  endDate         DateTime?
  nextBillingDate DateTime?
  recurringAmount Decimal            @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lines           SubscriptionLine[]

  @@index([status])
  @@index([customerId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  qty            Int          @default(1)
  unitPrice      Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)

  @@index([subscriptionId])
  @@map("subscription_lines")
}

// ---- Audit ----
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  entityType String
  entityId   String?
  action     String
  message    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---- Shared domain enums (mirror packages/shared/src/enums.ts) ----

// Roles are now data (see model Role). UserRole enum removed in favor of the RBAC tables.

enum QuotationStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  NEGOTIATION
  CONVERTED_TO_FULFILLMENT
  FULFILLING
  PARTIALLY_FULFILLED
  FULFILLED
  BILLING
  INVOICED
  PAID
  COMPLETED
  CANCELLED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  ESCALATED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum FulfillmentStatus {
  PENDING
  ALLOCATING
  ALLOCATED
  PARTIALLY_ALLOCATED
  BACKORDERED
  READY_TO_SHIP
  FULFILLED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  CANCELLED
}

enum BackorderStatus {
  OPEN
  PARTIALLY_ALLOCATED
  FULFILLED
  CANCELLED
}

enum AllocationSource {
  INITIAL
  BACKORDER
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ProductType {
  ONE_TIME
  RECURRING
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum CustomerSegment {
  STANDARD
  SMB
  ENTERPRISE
  STRATEGIC
}
