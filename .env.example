# ─── Database ───────────────────────────────────────────────────────────────
# Option A (default): local PostgreSQL installed on your machine (NOT Docker).
#   Create the database once:  createdb dealflow360    (or via pgAdmin / psql)
#   Adjust user/password/port to match your local install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealflow360?schema=public"

# Option B: PostgreSQL via Docker Compose (docker compose up -d) on port 5433.
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT are used by
#   docker-compose.yml. If you use Docker, set DATABASE_URL to port 5433 with these creds.
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=dealflow
POSTGRES_DB=dealflow360
POSTGRES_PORT=5433
# DATABASE_URL="postgresql://dealflow:dealflow@localhost:5433/dealflow360?schema=public"

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
COOKIE_DOMAIN=localhost

# ─── Initial admin (created by the seed; ADMIN cannot self-signup) ────────────
ADMIN_EMAIL=admin@dealflow.test
ADMIN_PASSWORD=password123

# ─── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
WEB_ORIGIN=http://localhost:3000
